# An example of the build guard's settings (docs/ops-tier.md, Build guard), read from
# /etc/askalf/pitlane-build.env by gha-ephemeral-build@.service as systemd environment lines.
# PITLANE_BUILD_BOOTSTRAP names the one job that runs without the allow list, as
# `<owner/repo> <branch> <file>`: the host deploy that installs the list, so a missing or wrong list can
# always be replaced by deploying again. Leave it out and every job needs its line on the list.
PITLANE_BUILD_BOOTSTRAP="example/app main deploy.yml"
